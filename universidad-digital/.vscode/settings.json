    "Alcance",
    "Fecha",
    "consolidacion",
    "consolidación",
    "evaluacion",
    "evaluación",
    "unico",
    "único",
    "reporte",
    "Copilot",
    "fullstack",
    "checklist",
    "checklists",
    "staging",
    "smoke",
    "backoff",
    "retry",
    "render",
    "rollout"
  ]
}
